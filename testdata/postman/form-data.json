{
  "info": {
    "name": "form-data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://127.0.0.1:47831"
    }
  ],
  "item": [
    {
      "name": "Echo",
      "request": {
        "method": "POST",
        "url": "http://127.0.0.1:47831/echo",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "text",
              "value": "hello",
              "type": "text"
            },
            {
              "key": "file",
              "src": "/tmp/example.txt",
              "type": "file"
            }
          ]
        }
      }
    }
  ]
}